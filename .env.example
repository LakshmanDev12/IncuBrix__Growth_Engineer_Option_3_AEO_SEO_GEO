# ==============================================================================
# IncuBrix AEO, SEO & GEO Visibility Engine Configuration
# Safe template for local development. Never commit sensitive keys to git.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_NAME=IncuBrix Visibility Engine
DEBUG=true

# Server Networking
HOST=127.0.0.1
PORT=8001
API_V1_PREFIX=/v1

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Storage Paths
DATABASE_URL=sqlite:///./data/visibility.db
DATA_DIR=./data
EVIDENCE_DIR=./evidence
OUTPUTS_DIR=./outputs

# IncuBrix Brand & Tracking Target Settings
INCUBRIX_BRAND_NAME=IncuBrix
INCUBRIX_DOMAINS=incubrix.com,app.incubrix.com

# External Provider Timeouts (HTTP requests)
HTTP_REQUEST_TIMEOUT_SECONDS=10.0

# Optional Search & AI Provider Credentials (Leave blank if not using live API queries)
# SERP_API_KEY=your_serper_or_serpapi_key_here
# SERP_API_URL=https://google.serper.dev/search
# AI_PROVIDER_API_KEY=your_perplexity_or_openai_key_here
# AI_PROVIDER_API_URL=https://api.perplexity.ai/chat/completions
# AI_PROVIDER_MODEL=sonar
